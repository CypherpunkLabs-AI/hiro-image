#!/usr/bin/env python3
"""Download a selected OS release and verify its signing identity and every artifact."""
import argparse
import json
from pathlib import Path
import re
from image_lib import digest, require, run


def verify(directory, repository, tag):
    require(re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repository), 'invalid repository')
    require(re.fullmatch(r'v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?', tag), 'select an explicit version tag')
    manifest_path = directory / 'os-release.json'
    data = json.loads(manifest_path.read_text())
    require(data.get('kind') == 'h-image.os-release.v1' and data.get('tag') == tag,
            'wrong OS manifest or version')
    require(data['source_repository'] == repository and data['source_ref'] == 'refs/tags/' + tag,
            'OS release repository/ref mismatch')
    require(re.fullmatch('[0-9a-f]{40}', data['source_commit'])
            and data['workflow_commit'] == data['source_commit'], 'release must use the tagged workflow commit')
    run('gh', 'attestation', 'verify', manifest_path, '--bundle', directory / 'os-release.sigstore.json',
        '--repo', repository, '--signer-workflow', repository + '/.github/workflows/image.yml',
        '--signer-digest', data['workflow_commit'], '--source-digest', data['source_commit'],
        '--source-ref', 'refs/tags/' + tag, '--predicate-type', 'https://slsa.dev/provenance/v1',
        '--deny-self-hosted-runners')
    for name, entry in data['files'].items():
        require(Path(name).name == name and name not in ('.', '..'), 'invalid artifact name')
        path = directory / name
        require(path.is_file() and not path.is_symlink() and path.stat().st_size == entry['size']
                and digest(path) == entry['sha256'], 'OS artifact differs from signed manifest: ' + name)
    return data


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repository', required=True, help='Owner/h-image, the trusted OS release repository')
    parser.add_argument('--version', required=True, help='Exact release tag, for example v0.1.0')
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--verify-only', action='store_true')
    args = parser.parse_args()
    require(re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', args.repository), 'invalid repository')
    require(re.fullmatch(r'v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?', args.version), 'invalid version')
    if not args.verify_only:
        require(not args.output.exists(), 'download destination must not exist')
        args.output.mkdir(parents=True)
        run('gh', 'release', 'download', args.version, '--repo', args.repository, '--dir', args.output)
    verify(args.output, args.repository, args.version)
    print('Verified OS ' + args.repository + '@' + args.version)
