#!/usr/bin/env python3
"""Retrieve a diagnostic boot's serial evidence without SSH or changing the VM."""
import argparse
import base64
import gzip
import hashlib
import io
import json
from pathlib import Path
import re
import subprocess


def decode(text, nonce):
    if not re.fullmatch('[0-9a-f]{128}', nonce):
        raise ValueError('nonce file must contain 128 lowercase hex characters')
    prefix = 'H_IMAGE_EVIDENCE_V1 ' + nonce + ' '
    begin = end = None
    chunks = {}
    for line in text.splitlines():
        if prefix not in line:
            continue
        fields = line.split(prefix, 1)[1].strip().split()
        if fields and fields[0] == 'BEGIN' and len(fields) == 3:
            if begin is not None:
                raise ValueError('multiple captures for this nonce; use a fresh nonce for each boot')
            begin = (int(fields[1]), fields[2])
            if not 1 <= begin[0] <= 456 or not re.fullmatch('[0-9a-f]{64}', begin[1]):
                raise ValueError('invalid evidence header')
        elif fields and fields[0] == 'DATA' and len(fields) == 3:
            index = int(fields[1])
            if begin is None or end is not None or index in chunks or not 0 <= index < begin[0]:
                raise ValueError('out-of-frame or duplicate evidence chunk')
            if len(fields[2]) > 768:
                raise ValueError('oversized evidence chunk')
            chunks[index] = fields[2]
        elif fields and fields[0] == 'END' and len(fields) == 2:
            if begin is None or end is not None:
                raise ValueError('invalid evidence trailer')
            end = fields[1]
        else:
            raise ValueError('malformed evidence frame')
    if begin is None or end != begin[1] or len(chunks) != begin[0]:
        raise ValueError('capture incomplete: rerun after boot; inspect serial port 1 for startup errors')
    compressed = base64.b64decode(''.join(chunks[i] for i in range(begin[0])), validate=True)
    if len(compressed) > 256 * 1024 or hashlib.sha256(compressed).hexdigest() != end:
        raise ValueError('serial evidence checksum mismatch')
    with gzip.GzipFile(fileobj=io.BytesIO(compressed)) as stream:
        raw = stream.read(24 * 1024 * 1024 + 1)
    if len(raw) > 24 * 1024 * 1024:
        raise ValueError('oversized decoded evidence')
    data = json.loads(raw)
    if data.get('schema') != 'h-image.boot-evidence.v1' or data.get('nonce') != nonce:
        raise ValueError('wrong evidence schema or challenge')
    files = {name: base64.b64decode(data[key], validate=True) for name, key in
             [('quote.bin', 'quote'), ('ccel.bin', 'ccel'), ('ccel-table.bin', 'ccel_table')]}
    quote = files['quote.bin']
    if (len(quote) < 636 or len(quote) > 64 * 1024 or quote[:2] != b'\x04\x00'
            or quote[4:8] != b'\x81\x00\x00\x00' or quote[168] & 1
            or quote[568:632] != bytes.fromhex(nonce)):
        raise ValueError('quote is not a non-debug TDX v4 quote with the requested challenge')
    if not 0 < len(files['ccel.bin']) <= 16 * 1024 * 1024 or not 0 < len(files['ccel-table.bin']) <= 4096:
        raise ValueError('missing or oversized CCEL data')
    return data, files


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--project', required=True)
    parser.add_argument('--zone', required=True)
    parser.add_argument('--instance', required=True)
    parser.add_argument('--nonce-file', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    if args.output.exists():
        parser.error('output directory already exists; choose a new directory')
    nonce = args.nonce_file.read_text().strip()
    if not re.fullmatch('[0-9a-f]{128}', nonce):
        parser.error('nonce file must contain 128 lowercase hex characters')
    common = ['--project=' + args.project, '--zone=' + args.zone]
    serial = subprocess.check_output([
        'gcloud', 'compute', 'instances', 'get-serial-port-output', args.instance,
        *common, '--port=2', '--start=0'], text=True, timeout=60)
    data, files = decode(serial, nonce)
    # Keep only launch configuration, never instance metadata (which may hold secrets).
    description = subprocess.check_output([
        'gcloud', 'compute', 'instances', 'describe', args.instance, *common,
        '--format=json(id,name,zone,machineType,creationTimestamp,lastStartTimestamp,'
        'confidentialInstanceConfig,shieldedInstanceConfig,advancedMachineFeatures,'
        'disks,networkInterfaces[].nicType)'], text=True, timeout=60)
    instance = json.loads(description)
    if instance.get('confidentialInstanceConfig', {}).get('confidentialInstanceType') != 'TDX':
        raise ValueError('GCP instance is not configured for TDX')
    args.output.mkdir(parents=True)
    for name, value in files.items():
        (args.output / name).write_bytes(value)
    (args.output / 'nonce.bin').write_bytes(bytes.fromhex(nonce))
    (args.output / 'nonce.hex').write_text(nonce + '\n')
    (args.output / 'serial.txt').write_text(serial)
    (args.output / 'instance.json').write_text(json.dumps(instance, indent=2) + '\n')
    (args.output / 'evidence.json').write_text(json.dumps(data, indent=2) + '\n')
    print('Collected quote, CCEL, challenge and launch configuration in ' + str(args.output))
    print('Evidence collected only: Intel DCAP verification, CCEL replay and firmware approval remain separate.')


if __name__ == '__main__':
    main()
