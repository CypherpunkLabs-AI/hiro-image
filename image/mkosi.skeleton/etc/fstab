LABEL=hiro-workload /mnt/workload ext4 ro,nosuid,nodev,noexec,noauto,x-systemd.device-timeout=30s 0 0
LABEL=hiro-config /mnt/config ext4 ro,nosuid,nodev,noexec,noauto,x-systemd.device-timeout=30s 0 0
