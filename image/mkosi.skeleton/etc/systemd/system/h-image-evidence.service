[Unit]
Description=Export requested public TDX boot evidence to serial port 2
ConditionPathExists=/sys/firmware/acpi/tables/CCEL
Requires=h-image-ready.service
Wants=network-online.target
After=h-image-ready.service network-online.target
Before=h-image-workload.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/h-image/export-evidence
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=120
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
