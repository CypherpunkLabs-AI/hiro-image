#!/usr/bin/python3
"""Report base OS readiness without claiming application or hardware attestation."""
import json
from pathlib import Path
import subprocess


def run(*args):
    return subprocess.check_output(args, text=True).strip()


root = json.loads(run('findmnt', '--json', '--target', '/', '--output', 'SOURCE,OPTIONS'))['filesystems'][0]
if 'ro' not in root['options'].split(',') or not root['source'].startswith(('/dev/mapper/', '/dev/dm-')):
    raise SystemExit('h-image requires a read-only device-mapper root')
verity = run('veritysetup', 'status', root['source'])
# veritysetup prints its device type as uppercase VERITY. Inspect the actual
# fields, not a substring which could also match a device or backing-file name.
fields = dict(line.strip().split(':', 1) for line in verity.splitlines() if ':' in line)
fields = {key.strip(): value.strip() for key, value in fields.items()}
if (fields.get('type') != 'VERITY' or fields.get('status') not in ('verified', 'verified (with signature)')
        or fields.get('mode') != 'readonly'):
    raise SystemExit('root must be verified, read-only dm-verity; veritysetup reported:\n' + verity)
subprocess.run(['swapoff', '--all'], check=True)
if Path('/proc/swaps').read_text().splitlines()[1:]:
    raise SystemExit('swap must be disabled')
run('docker', 'info', '--format', '{{.ServerVersion}}')
run('docker', 'compose', 'version')
subprocess.run(['/usr/lib/h-image/tdx-extend', '-help'], check=True,
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
print('H_IMAGE_OS_READY: dm-verity root, Docker, Compose and TDX helper ready', flush=True)
